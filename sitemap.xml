---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% assign sitemap_pages = site.pages | where_exp: "p", "p.sitemap != false" | where_exp: "p", "p.url != '/404.html'" | where_exp: "p", "p.url != '/sitemap.xml'" %}
{% for p in sitemap_pages %}
  {% assign lastmod = p.last_modified_at | default: site.time | date: '%Y-%m-%d' %}
  {% if p.bilingual %}
    {% if p.lang == 'ru' %}
      {% if p.url == '/ru/' or p.url == '/ru' %}
        {% assign en_href = 'https://bakasana.app/' %}
      {% else %}
        {% assign en_path = p.url | replace_first: '/ru', '' %}
        {% assign en_href = 'https://bakasana.app' | append: en_path %}
      {% endif %}
      {% assign ru_href = 'https://bakasana.app' | append: p.url %}
    {% else %}
      {% assign en_href = 'https://bakasana.app' | append: p.url %}
      {% if p.url == '/' %}
        {% assign ru_href = 'https://bakasana.app/ru/' %}
      {% else %}
        {% assign ru_href = 'https://bakasana.app/ru' | append: p.url %}
      {% endif %}
    {% endif %}
  {% endif %}
  <url>
    <loc>https://bakasana.app{{ p.url }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    {% if p.bilingual %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ en_href }}" />
    <xhtml:link rel="alternate" hreflang="ru" href="{{ ru_href }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ en_href }}" />
    {% endif %}
  </url>
{% endfor %}
</urlset>
